# Copy to .env locally. Do not commit real secrets.
# Server-only (never VITE_ prefix for secrets):
XAI_API_KEY=
DAILY_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public Supabase (anon key is designed for the browser):
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Optional models
XAI_MODEL_ADMIN=grok-4.3
XAI_MODEL_TRANSLATOR=grok-4.6
XAI_MODEL_TUTOR=grok-4.6
