# Copy to .env locally. Do not commit real secrets.
# Server-only (never VITE_ prefix for secrets):
XAI_API_KEY=
DAILY_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Phone OTP: HMAC pepper for OTP + IP hashes (>= 32 random chars, e.g. `openssl rand -hex 32`).
# REQUIRED before phone login is enabled; the server fails closed without it.
OTP_PEPPER=
# Phone login (HB-01): enabled only when PHONE_LOGIN_ENABLED=on AND TURNSTILE_SECRET_KEY is set;
# every OTP request is then verified server-side via Turnstile siteverify (fail closed).
PHONE_LOGIN_ENABLED=
TURNSTILE_SECRET_KEY=
# Comma-separated hostnames accepted in the siteverify response (required; empty = all requests rejected).
TURNSTILE_ALLOWED_HOSTNAMES=
# Public Turnstile site key for the client widget (public by design):
VITE_TURNSTILE_SITE_KEY=
# Client-IP source (src/lib/client-ip.ts). VERCEL=1 is set by Vercel itself.
# Set EDGE_PLATFORM=cloudflare only if the origin is reachable via Cloudflare only;
# TRUSTED_PROXY=on only behind another proxy that overwrites x-real-ip.
EDGE_PLATFORM=
TRUSTED_PROXY=

# Public Supabase (anon key is designed for the browser):
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Optional models
XAI_MODEL_ADMIN=grok-4.3
XAI_MODEL_TRANSLATOR=grok-4.6
XAI_MODEL_TUTOR=grok-4.6
